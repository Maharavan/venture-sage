# ── AWS ──────────────────────────────────────────────────────────────────────
# Required if not using IAM roles or `aws configure`.
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_DEFAULT_REGION=us-east-1

# ── Web Research APIs ─────────────────────────────────────────────────────────
# All five keys are required at startup (checked by check_tool_environments).

# Exa — neural search (founder research, funding history)
# https://exa.ai
EXA_API_KEY=your_exa_api_key

# Tavily — AI search (product reviews, revenue signals)
# https://tavily.com
TAVILY_API_KEY=your_tavily_api_key

# SerpAPI — Google/Bing SERP results (competitor search, team growth)
# https://serpapi.com
SERPAPI_API_KEY=your_serpapi_api_key

# NewsAPI — news headlines (market news)
# https://newsapi.org
NEWSAPI_KEY=your_newsapi_key

# Firecrawl — web scraping (competitor pricing pages)
# https://firecrawl.dev
FIRECRAWL_API_KEY=your_firecrawl_api_key
